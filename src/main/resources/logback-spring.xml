<?xml version="1.0" encoding="UTF-8"?>
<!--
  로그 설정 — 하루에 파일 하나.

  properties(logging.file.name)만으로는 "현재 파일"이 항상 고정 이름(cjairport.log)이고
  날짜가 붙은 파일은 자정 이후 처음 로그가 찍힐 때 '지난 날짜'로 밀려 나온다.
  운영에서 오늘 로그를 찾기 어렵고, 자정을 넘겨도 새 파일이 안 보이는 것처럼 느껴진다.

  여기서는 <file> 을 지정하지 않는다(logback file-less 모드). 그러면 지금 쓰는 파일이
  곧 오늘 날짜 파일이 된다.

      logs/cjairport.2026-08-06.0.txt   ← 오늘. 지금 쌓이는 중
      logs/cjairport.2026-08-05.0.txt   ← 어제

  한 파일에 기동·오류·경고 + 업무 이력(AUDIT) + 요청 로그(REQUEST)가 시간순으로 모인다.
  같은 요청은 [요청ID] 가 같아 한 줄기로 이어 볼 수 있다.
-->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <springProperty scope="context" name="LOG_PATH" source="LOG_PATH" defaultValue="logs"/>
  <springProperty scope="context" name="LOG_KEEP_DAYS" source="LOG_KEEP_DAYS" defaultValue="30"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <!-- <file> 없음 = 지금 쓰는 파일이 곧 오늘 날짜 파일 -->
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/cjairport.%d{yyyy-MM-dd}.%i.txt</fileNamePattern>
      <!-- 하루 단위. 하루치가 50MB 를 넘으면 .1.txt, .2.txt 로 이어 쓴다 -->
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>${LOG_KEEP_DAYS}</maxHistory>
      <totalSizeCap>1GB</totalSizeCap>
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
    <encoder>
      <pattern>${FILE_LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
