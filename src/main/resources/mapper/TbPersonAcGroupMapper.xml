<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="AirPort.mapper.TbPersonAcGroupMapper">

  <delete id="deleteByPerson">
    DELETE FROM tb_person_ac_group WHERE person_id = #{personId}
  </delete>

  <insert id="insertBatch">
    INSERT INTO tb_person_ac_group (person_id, ac_group_id) VALUES
    <foreach collection="acGroupIds" item="id" separator=",">
      (#{personId}, #{id})
    </foreach>
  </insert>

  <select id="selectAcGroupIds" resultType="int">
    SELECT ac_group_id FROM tb_person_ac_group WHERE person_id = #{personId}
  </select>

  <!-- BiostarX access_groups 용 — 매핑된 출입그룹 중 biostar_ac_id 가 있는 것만 -->
  <select id="selectBiostarAcIds" resultType="int">
    SELECT g.biostar_ac_id
    FROM tb_person_ac_group pg
    JOIN tb_ac_group g ON g.ac_group_id = pg.ac_group_id
    WHERE pg.person_id = #{personId} AND g.biostar_ac_id IS NOT NULL
  </select>

</mapper>
